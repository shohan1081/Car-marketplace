# car-video-agent environment.
# On the server this file lives at car-video-agent/car-video-agent/.env
# and is NEVER committed to git.

# fal.ai API key -- runs the Kling image-to-video model.
FAL_KEY=

# OpenAI API key -- used to identify the car in the reference photo so the
# generated video keeps the same model and colour.
OPENAI_API_KEY=

# Where this service POSTs the finished video back to Django.
# "web" is the Django container's name on the private Docker network, so this
# call never leaves the server. The token must match AI_VIDEO_WEBHOOK_TOKEN
# in the Django .env, or Django rejects the callback with 401.
BACKEND_WEBHOOK_URL=http://web:8000/api/vehicles/ai-video/webhook/?token=REPLACE_WITH_SAME_TOKEN_AS_DJANGO
