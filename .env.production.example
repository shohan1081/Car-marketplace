# ===========================================================================
# Nory backend -- production environment template.
#
# On the server:   cp .env.production.example .env   then fill every value in.
# The real .env is NEVER committed. This file is read twice:
#   1. by docker compose, to fill in ${...} placeholders in docker-compose.yml
#   2. by the web / ws containers, as their process environment
#
# IMPORTANT: do not use the "$" character inside any value. Compose treats it
# as the start of a variable and will mangle the value. Generate passwords
# with `openssl rand -hex 32`, which never produces one.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. Domain and nginx
# ---------------------------------------------------------------------------
# The public domain this API is served on, without scheme or trailing slash.
DOMAIN=api.buysoloio.com

# Which nginx site config to load.
#   app.http.conf   -> plain HTTP. Use this for the FIRST boot, and while
#                      issuing the TLS certificate.
#   app.https.conf  -> HTTP redirects to HTTPS, TLS terminated by nginx.
#                      Switch to this only after certbot has succeeded.
NGINX_CONF=app.http.conf


# ---------------------------------------------------------------------------
# 2. PostgreSQL
# ---------------------------------------------------------------------------
# These three create the database inside the `db` container on first start.
# Changing them later does NOT rename an existing database.
POSTGRES_DB=nory
POSTGRES_USER=nory
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# How Django connects. The host is "db" -- the compose service name, not
# localhost. The three values here must match the three above exactly.
DATABASE_URL=postgres://nory:CHANGE_ME_openssl_rand_hex_32@db:5432/nory


# ---------------------------------------------------------------------------
# 3. Redis
# ---------------------------------------------------------------------------
# Backs the Channels layer (chat + notifications) and Django's cache.
# Required in production: gunicorn and daphne are separate processes and can
# only reach each other through Redis.
REDIS_URL=redis://redis:6379/0


# ---------------------------------------------------------------------------
# 4. Django core
# ---------------------------------------------------------------------------
# Never True on a server. With DEBUG=True Django serves tracebacks containing
# your settings and database contents to anyone who triggers an error.
DEBUG=False

# Generate a fresh one for production, do not reuse the development key:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Note this also signs every JWT (SIMPLE_JWT SIGNING_KEY), so changing it
# logs every user out.
SECRET_KEY=CHANGE_ME_generate_a_new_one

# Host headers Django will accept. Must include:
#   - your public domain(s)
#   - "web" and "ws": the internal container names, used by the AI video
#     webhook and by the container healthchecks
#   - "127.0.0.1": used by the healthcheck curl
DJANGO_ALLOWED_HOSTS=api.buysoloio.com,web,ws,localhost,127.0.0.1

# Needed for the Django admin login form once you are on HTTPS. Include the
# scheme. Leave empty until you have a domain.
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.buysoloio.com

# Only needed if a BROWSER-based frontend calls this API from another origin.
# The Flutter mobile app does not need this; leave it empty.
DJANGO_CORS_ALLOWED_ORIGINS=

DJANGO_LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
# 5. HTTPS hardening
# ---------------------------------------------------------------------------
# Keep all three OFF until the certificate is installed and https:// works.
# Turning them on too early makes the site unreachable, because Django will
# redirect plain HTTP to an HTTPS endpoint that does not exist yet.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False

# Then: 0 -> 3600 (test for a day) -> 31536000 (one year, the real value).
DJANGO_SECURE_HSTS_SECONDS=0


# ---------------------------------------------------------------------------
# 6. Gunicorn sizing
# ---------------------------------------------------------------------------
# Rule of thumb: workers = (2 x vCPU) + 1.
#   t3.small  (2 vCPU) -> 5      t3.medium (2 vCPU) -> 5
# Each worker is a full copy of Django in memory (roughly 150-250 MB here),
# so on a 2 GB instance stay at 3.
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
# Must be >= the slowest legitimate request. The AI-video webhook downloads a
# finished video from fal.ai inside the request, which is the slow one.
GUNICORN_TIMEOUT=120


# ---------------------------------------------------------------------------
# 7. Email (OTP codes, verification mails)
# ---------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@example.com
# For Gmail this is a 16-character App Password, not your account password.
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=your_email@example.com


# ---------------------------------------------------------------------------
# 8. AI video service (the car-video-agent container)
# ---------------------------------------------------------------------------
# "agent" is the compose service name. This URL never leaves the server, so
# the AI service is not exposed to the internet at all.
AI_VIDEO_SERVICE_URL=http://agent:8000

# Shared secret protecting the callback the agent makes into Django. The exact
# same value must appear in the agent's own .env, inside BACKEND_WEBHOOK_URL:
#   BACKEND_WEBHOOK_URL=http://web:8000/api/vehicles/ai-video/webhook/?token=<this>
# Generate with: openssl rand -hex 32
# If it is blank, Django rejects every callback with 401 (fail closed).
AI_VIDEO_WEBHOOK_TOKEN=CHANGE_ME_openssl_rand_hex_32


# ---------------------------------------------------------------------------
# 9. Firebase (phone / social login verification)
# ---------------------------------------------------------------------------
# Path INSIDE the container. Put the JSON file at ./secrets/firebase.json on
# the host; compose mounts ./secrets read-only at /run/secrets.
# Leave blank to disable Firebase login.
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase.json


# ---------------------------------------------------------------------------
# 10. In-app purchases
# ---------------------------------------------------------------------------
# --- Apple ---
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# The .p8 contents on one line, with real newlines written as \n
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.yourapp.bundle
# sandbox | production
APPLE_ENVIRONMENT=production

# --- Google Play ---
GOOGLE_PLAY_PACKAGE_NAME=com.yourapp.package
# Again a path inside the container: put the file at ./secrets/google-play.json
GOOGLE_SERVICE_ACCOUNT_JSON=/run/secrets/google-play.json

# --- RevenueCat ---
REVENUECAT_WEBHOOK_AUTH_TOKEN=
